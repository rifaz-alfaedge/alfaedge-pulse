# Python
__pycache__/
*.py[cod]
*.egg-info/

# Frontend build output — regenerated by `npm run build` (see README);
# committing it would mean the repo's compiled JS/CSS drifts from source
# the moment anyone edits frontend/src without rebuilding.
alfaedge_pulse/public/alfaedge-pulse/

# Frontend dependencies / tooling caches
frontend/node_modules/
frontend/node_modules/.tmp/
frontend/dist/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Never commit real credentials
.env
*.env.local
site_config.json
