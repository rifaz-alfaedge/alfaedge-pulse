 "fields": [
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Polling Enabled",
   "default": "0",
   "description": "Off by default. Nothing connects to any host until this is on."
  },
  {
   "fieldname": "connection_mode",
   "fieldtype": "Select",
   "label": "Connection Mode",
   "options": "Warpgate\nDirect",
   "default": "Warpgate",
   "reqd": 1,
   "description": "Warpgate: Pulse logs in to your bastion as <user>:<target> and Warpgate reaches the server. Direct: Pulse logs in to each host itself."
  },
  {
   "fieldname": "connection_section",
   "fieldtype": "Section Break",
   "label": "Connection"
  },
  {
   "fieldname": "server_host",
   "fieldtype": "Data",
   "label": "Warpgate Host",
   "depends_on": "eval:doc.connection_mode=='Warpgate'",
   "mandatory_depends_on": "eval:doc.connection_mode=='Warpgate'"
  },
  {
   "fieldname": "server_port",
   "fieldtype": "Int",
   "label": "Warpgate SSH Port",
   "default": "2222",
   "depends_on": "eval:doc.connection_mode=='Warpgate'"
  },
  {
   "fieldname": "warpgate_user",
   "fieldtype": "Data",
   "label": "Warpgate User",
   "depends_on": "eval:doc.connection_mode=='Warpgate'",
   "mandatory_depends_on": "eval:doc.connection_mode=='Warpgate'",
   "description": "The Warpgate user that holds Pulse's public key, e.g. pulse-monitor."
  },
  {
   "fieldname": "default_user",
   "fieldtype": "Data",
   "label": "Default SSH User",
   "depends_on": "eval:doc.connection_mode=='Direct'",
   "description": "Used when a host does not set its own SSH user."
  },
  {
   "fieldname": "default_bench_path",
   "fieldtype": "Data",
   "label": "Default Bench Path",
   "description": "Used when a host does not set its own bench path, e.g. /home/ubuntu/frappe-bench."
  },
  {
   "fieldname": "server_host_key",
   "fieldtype": "Small Text",
   "label": "Pinned Warpgate Host Key",
   "read_only": 1,
   "depends_on": "eval:doc.connection_mode=='Warpgate'",
   "description": "Stored on first connection. A change blocks polling until you reset it."
  },
  {
   "fieldname": "reset_host_key",
   "fieldtype": "Button",
   "label": "Reset Pinned Host Key",
   "depends_on": "eval:doc.connection_mode=='Warpgate'"
  },
  {
   "fieldname": "key_section",
   "fieldtype": "Section Break",
   "label": "SSH Key"
  },
  {
   "fieldname": "public_key",
   "fieldtype": "Small Text",
   "label": "Public Key",
   "read_only": 1,
   "description": "Add this to the Warpgate user (or to authorized_keys in Direct mode)."
  },
  {
   "fieldname": "key_fingerprint",
   "fieldtype": "Data",
   "label": "Fingerprint",
   "read_only": 1
  },
  {
   "fieldname": "private_key",
   "fieldtype": "Password",
   "label": "Private Key",
   "read_only": 1,
   "description": "Encrypted, write-only, never sent to the browser."
  },
  {
   "fieldname": "key_passphrase",
   "fieldtype": "Password",
   "label": "Key Passphrase",
   "description": "Only if you imported a passphrase-protected key."
  },
  {
