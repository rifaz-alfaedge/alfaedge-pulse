 "fields": [
  {
   "fieldname": "connection_section",
   "fieldtype": "Section Break",
   "label": "Connection"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "0"
  },
  {
   "fieldname": "protocol",
   "fieldtype": "Select",
   "label": "Protocol",
   "options": "http\nhttps",
   "default": "http"
  },
  {
   "fieldname": "host",
   "fieldtype": "Data",
   "label": "Host",
   "description": "Hostname or IP only, no scheme/port — e.g. 10.10.10.202 or chlogs.alfaedge.in"
  },
  {
   "fieldname": "port",
   "fieldtype": "Int",
   "label": "Port",
   "default": "8123",
   "description": "ClickHouse HTTP port (8123 by default). Set 0 to use the protocol's default (80/443), e.g. behind a reverse proxy."
  },
  {
   "fieldname": "url_path",
   "fieldtype": "Data",
   "label": "URL Path",
   "description": "Optional sub-path if ClickHouse sits behind a reverse proxy path, e.g. /clickhouse"
  },
  {
   "fieldname": "verify_ssl",
   "fieldtype": "Check",
   "label": "Verify SSL Certificate",
   "default": "1",
   "depends_on": "eval:doc.protocol=='https'"
  },
  {
   "fieldname": "query_timeout_seconds",
   "fieldtype": "Int",
   "label": "Query Timeout (seconds)",
   "default": "30"
  },
  {
   "fieldname": "effective_url",
   "fieldtype": "Data",
   "label": "Effective URL",
   "read_only": 1,
   "is_virtual": 1
  },
  {
   "fieldname": "column_break_connection",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "username",
   "fieldtype": "Password",
   "label": "Username",
   "description": "Stored encrypted."
  },
  {
   "fieldname": "password",
   "fieldtype": "Password",
   "label": "Password",
   "description": "Stored encrypted."
  },
  {
   "fieldname": "api_key",
   "fieldtype": "Password",
   "label": "API Key / Token",
   "description": "Optional — only for a reverse proxy in front of ClickHouse that requires its own key. Stored encrypted."
  },
  {
   "fieldname": "api_key_header",
   "fieldtype": "Data",
   "label": "API Key Header",
   "default": "Authorization",
   "depends_on": "api_key"
  },
  {
   "fieldname": "api_key_prefix",
   "fieldtype": "Data",
   "label": "API Key Prefix",
   "default": "Bearer ",
   "depends_on": "api_key",
   "description": "Prepended to the key in the header value (include a trailing space). Leave blank to send the key as-is."
  },
  {
   "fieldname": "database_name",
   "fieldtype": "Data",
   "label": "Database",
   "default": "alfaedge_logs"
  },
  {
   "fieldname": "table_name",
   "fieldtype": "Data",
   "label": "Table",
   "default": "frappe_logs"
  },
  {
   "fieldname": "test_connection",
   "fieldtype": "Button",
   "label": "Test Connection"
  },
  {
   "fieldname": "columns_section",
   "fieldtype": "Section Break",
   "label": "Column Mapping",
   "collapsible": 1,
   "description": "Which ClickHouse columns hold each piece of a log row. Only change these if the server script's table layout differs."
  },
  {
   "fieldname": "ts_column",
   "fieldtype": "Data",
   "label": "Timestamp Column",
   "default": "ts"
  },
  {
   "fieldname": "site_column",
   "fieldtype": "Data",
   "label": "Site URL Column",
   "default": "site_url"
  },
  {
   "fieldname": "content_column",
   "fieldtype": "Data",
   "label": "Content Column",
   "default": "content",
   "description": "Full log text / traceback. Also what the Error keyword is matched against."
  },
  {
   "fieldname": "column_break_columns",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "title_column",
   "fieldtype": "Data",
   "label": "Title Column",
   "description": "Optional short title/method column. Blank = derive from the first line of Content."
  },
  {
   "fieldname": "id_column",
   "fieldtype": "Data",
   "label": "ID Column",
   "description": "Optional unique row id column (e.g. the Error Log docname). Blank = a hash of timestamp + site + content."
  },
  {
   "fieldname": "log_type_column",
   "fieldtype": "Data",
   "label": "Log Type Column",
   "description": "Optional — if the table already stores a type, map it here. Blank = classify by the Error keyword below."
  },
  {
   "fieldname": "classification_section",
   "fieldtype": "Section Break",
   "label": "Classification"
  },
  {
   "fieldname": "error_keyword",
   "fieldtype": "Data",
   "label": "Error Keyword",
   "default": "error",
   "description": "A row whose content contains this text (case-insensitive) is an Error log; everything else is a General log."
  },
  {
   "fieldname": "alerts_section",
   "fieldtype": "Section Break",
   "label": "Recurring Error Alerts"
  },
  {
   "fieldname": "enable_recurring_alerts",
   "fieldtype": "Check",
   "label": "Enable Recurring Error Alerts",
   "default": "1"
  },
  {
   "fieldname": "occurrence_threshold",
   "fieldtype": "Int",
   "label": "Occurrence Threshold",
   "default": "5",
   "description": "Alert when the same error on the same site occurs at least this many times…"
  },
  {
   "fieldname": "window_minutes",
   "fieldtype": "Int",
   "label": "Window (minutes)",
   "default": "60",
   "description": "…within this rolling window. Recovery is sent once it drops back under the threshold for the same window."
  },
  {
   "fieldname": "column_break_alerts",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "check_interval_minutes",
   "fieldtype": "Int",
   "label": "Check Interval (minutes)",
   "default": "2"
  },
  {
   "fieldname": "notify_global_recipients",
   "fieldtype": "Check",
   "label": "Also Notify Global Recipients",
   "default": "0",
   "description": "Off: recurring errors go only to engineers who subscribed to the site (Alert Subscription → Log Sites). On: also to the global Email/WhatsApp recipients in Proxmox Monitor Settings."
  },
  {
   "fieldname": "status_section",
   "fieldtype": "Section Break",
   "label": "Status"
  },
  {
   "fieldname": "last_checked",
   "fieldtype": "Datetime",
   "label": "Last Checked",
   "read_only": 1
  },
  {
   "fieldname": "column_break_status",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "last_error",
   "fieldtype": "Small Text",
   "label": "Last Error",
   "read_only": 1
  }
 ],
